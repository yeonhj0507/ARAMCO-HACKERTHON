# 이 파일을 .env로 복사해서 채우세요. .env는 git에 안 올라갑니다.
# up_로 시작하는 키 (Studio 가입 시 자동 생성)
UPSTAGE_API_KEY=

# Solar 채팅 (run.bat chat)
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
# 비우면 solar-pro-4
UPSTAGE_MODEL=solar-pro-4

# Studio 에이전트 (run.bat ingest)
# Studio 에이전트 화면의 Code 버튼에서 확인
UPSTAGE_STUDIO_AGENT_ID=
# 선택: 비우면 기본 설정으로 실행 (최신 버전이 아닐 수 있음)
UPSTAGE_STUDIO_CONFIG_ID=
UPSTAGE_STUDIO_BASE_URL=https://api.upstage.ai/v2
UPSTAGE_STUDIO_AGENT_B=
UPSTAGE_STUDIO_CONFIG_B=
UPSTAGE_STUDIO_AGENT_C=
UPSTAGE_STUDIO_CONFIG_C=
